#!/usr/bin/env python3
"""sheprd usage hook for Claude Code (Stop hook).

After each agent turn, read the new part of the session transcript and report
to herdr, as pane metadata tokens (visible to every sheprd client):
  sheprd_ctx      current context size in tokens (last request's input side)
  sheprd_session  Claude session id
  sheprd_u_YYYYMMDD  one per local day (last 7): "input,output,cache_read,
                  cache_write,active_minutes" (herdr caps values at 80 chars,
                  hence one short token per day)
Incremental: a per-session cache remembers the read offset and totals, so a
turn costs only the new lines. Never fails the agent: any error exits 0.

Install: sheprd-install-hooks (adds this as a Stop hook in ~/.claude/settings.json).
"""
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta

CACHE_DIR = os.path.expanduser("~/.cache/sheprd/usage")
KEEP_DAYS = 7


def local_day_minute(timestamp):
    """ISO UTC timestamp -> (local 'YYYY-MM-DD', local 'HH:MM')."""
    when = datetime.fromisoformat(timestamp.replace("Z", "+00:00")).astimezone()
    return when.strftime("%Y-%m-%d"), when.strftime("%H:%M")


def main():
    hook = json.load(sys.stdin)
    pane = os.environ.get("HERDR_PANE_ID")
    transcript = hook.get("transcript_path")
    session = hook.get("session_id")
    if not (pane and transcript and session and os.path.exists(transcript)):
        return

    os.makedirs(CACHE_DIR, exist_ok=True)
    cache_path = os.path.join(CACHE_DIR, f"{session}.json")
    try:
        with open(cache_path) as handle:
            cache = json.load(handle)
    except (OSError, ValueError):
        cache = {"offset": 0, "last_id": None, "ctx": 0, "days": {}}
    if os.path.getsize(transcript) < cache["offset"]:
        cache = {"offset": 0, "last_id": None, "ctx": 0, "days": {}}

    with open(transcript, "rb") as handle:
        handle.seek(cache["offset"])
        for raw in handle:
            if not raw.endswith(b"\n"):
                break  # partial line still being written; read it next time
            cache["offset"] += len(raw)
            try:
                entry = json.loads(raw)
            except ValueError:
                continue
            message = entry.get("message") or {}
            usage = message.get("usage")
            if entry.get("type") != "assistant" or not usage or not entry.get("timestamp"):
                continue
            # A streamed reply repeats the same message id on several lines.
            if message.get("id") and message.get("id") == cache["last_id"]:
                continue
            cache["last_id"] = message.get("id")
            day, minute = local_day_minute(entry["timestamp"])
            totals = cache["days"].setdefault(day, [0, 0, 0, 0, []])
            totals[0] += usage.get("input_tokens", 0)
            totals[1] += usage.get("output_tokens", 0)
            totals[2] += usage.get("cache_read_input_tokens", 0)
            totals[3] += usage.get("cache_creation_input_tokens", 0)
            if minute not in totals[4]:
                totals[4].append(minute)
            cache["ctx"] = (
                usage.get("input_tokens", 0)
                + usage.get("cache_read_input_tokens", 0)
                + usage.get("cache_creation_input_tokens", 0)
            )

    oldest = (datetime.now() - timedelta(days=KEEP_DAYS - 1)).strftime("%Y-%m-%d")
    cache["days"] = {day: totals for day, totals in cache["days"].items() if day >= oldest}
    tmp = cache_path + ".tmp"
    with open(tmp, "w") as handle:
        json.dump(cache, handle)
    os.replace(tmp, cache_path)

    args = [
        "--token", f"sheprd_ctx={cache['ctx']}",
        "--token", f"sheprd_session={session}",
    ]
    for day, t in sorted(cache["days"].items()):
        values = ",".join(str(v) for v in t[:4] + [len(t[4])])
        args += ["--token", f"sheprd_u_{day.replace('-', '')}={values}"]
    expired = (datetime.now() - timedelta(days=KEEP_DAYS)).strftime("%Y%m%d")
    args += ["--clear-token", f"sheprd_u_{expired}"]
    herdr = os.environ.get("HERDR_BIN_PATH") or "herdr"
    subprocess.run(
        [herdr, "pane", "report-metadata", pane, "--source", "sheprd", *args],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=5,
        check=False,
    )


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 - a usage hook must never break the agent
        pass
    sys.exit(0)
