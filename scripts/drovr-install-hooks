#!/usr/bin/env bash
# Install drovr's Claude Code usage hook on this machine (run on every machine
# where agents run). Copies the hook to ~/.local/bin and registers it as a Stop
# hook in ~/.claude/settings.json (backup kept; existing hooks untouched).
# The hook always comes from sbusso/drovr (main), never from the current
# directory: under `curl ... | bash` there is no script directory to resolve.
set -euo pipefail
src="$(mktemp)"
trap 'rm -f "$src"' EXIT
curl -fsSL https://raw.githubusercontent.com/sbusso/drovr/main/scripts/drovr-usage-hook -o "$src"
mkdir -p "$HOME/.local/bin" "$HOME/.claude"
install -m 0755 "$src" "$HOME/.local/bin/drovr-usage-hook"
settings="$HOME/.claude/settings.json"
[ -f "$settings" ] || echo '{}' > "$settings"
cp "$settings" "$settings.bak-pre-drovr-usage"
python3 - "$settings" "$HOME/.local/bin/drovr-usage-hook" <<'EOF'
import json, sys
path, hook = sys.argv[1], sys.argv[2]
settings = json.load(open(path))
stop = settings.setdefault("hooks", {}).setdefault("Stop", [])
command = f"python3 {hook}"
if not any(h.get("command") == command for group in stop for h in group.get("hooks", [])):
    stop.append({"hooks": [{"type": "command", "command": command}]})
json.dump(settings, open(path, "w"), indent=2)
print("registered:", command)
EOF
echo "drovr usage hook installed (backup: $settings.bak-pre-drovr-usage)"
